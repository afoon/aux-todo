{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "paths": {
      "#routes/*": ["./src/routes/*"]
    },
    "module": "esnext",
    "moduleResolution": "node",
    "target": "esnext",
    "verbatimModuleSyntax": true,

  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
